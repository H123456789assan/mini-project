<!DOCTYPE html>
<html>
<head>
    <title>Signup - Butcheré</title>
    <style>
        body {
            margin: 0;
            font-family: Georgia, serif;
            background: linear-gradient(to right, #2a0000, #5a0000);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .auth-card {
            background: #3a0000;
            padding: 50px 40px;
            width: 400px;
            text-align: center;
            color: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        h2 {
            margin-bottom: 10px;
            font-size: 28px;
        }

        .sub {
            color: #d4af37;
            margin-bottom: 30px;
            font-style: italic;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: none;
            outline: none;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #8b0000;
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }

        button:hover {
            background: #a30000;
        }

        .switch {
            margin-top: 20px;
            font-size: 14px;
        }

        .switch a {
            color: #d4af37;
            text-decoration: none;
        }

        .switch a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

<div class="auth-card">
    <h2>Create Account</h2>
    <p class="sub">Join Butcheré Premium</p>

    <form action="/signup" method="POST">
        <input type="text" name="name" placeholder="Full Name" required>
        <input type="email" name="email" placeholder="Email Address" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">SIGN UP</button>
    </form>

    <div class="switch">
        Already have an account?
        <a href="/login">Login</a>
    </div>
</div>

</body>
</html>