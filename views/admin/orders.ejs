<%- include('../partials/adminHeader') %>

<h1>Orders</h1>

<% orders.forEach(order => { %>
    <div class="card">
        <p>User: <%= order.user.name %></p>
        <p>Total: ₹ <%= order.totalPrice %></p>
        <p>Date: <%= order.createdAt.toDateString() %></p>
    </div>
<% }) %>

<%- include('../partials/adminFooter') %>